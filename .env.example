# =============================================================================
# AxisMind — Environment Variables Template
# =============================================================================
# ⚠️ ВНИМАНИЕ: Скопируйте этот файл в .env и заполните реальными значениями.
#    .env добавлен в .gitignore и НЕ должен попадать в репозиторий!
#
#    Эти же переменные используются через --dart-define при сборке.
#    Для локальной разработки можно задать их в системе или передавать
#    через флаги: flutter run --dart-define=FIREBASE_PROJECT_ID=...
#
#    Получить актуальные значения можно из Firebase Console:
#    https://console.firebase.google.com/project/zenbalance-app-295e3/settings/general
# =============================================================================

# --- Firebase Project ---
FIREBASE_PROJECT_ID=zenbalance-app-295e3
FIREBASE_MESSAGING_SENDER_ID=1087324654589
FIREBASE_AUTH_DOMAIN=zenbalance-app-295e3.firebaseapp.com
FIREBASE_STORAGE_BUCKET=zenbalance-app-295e3.firebasestorage.app

# --- Android ---
FIREBASE_ANDROID_API_KEY=AIzaSy...
FIREBASE_ANDROID_APP_ID=1:1087324654589:android:...

# --- iOS / macOS ---
FIREBASE_IOS_API_KEY=AIzaSy...
FIREBASE_IOS_APP_ID=1:1087324654589:ios:...
FIREBASE_IOS_BUNDLE_ID=com.axismind.app

# --- Web / Windows ---
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_WEB_APP_ID=1:1087324654589:web:...

# --- Web Push (VAPID) ---
FIREBASE_VAPID_KEY=BA...

# --- Google Sign-In ---
GOOGLE_SIGNIN_CLIENT_ID=...apps.googleusercontent.com
